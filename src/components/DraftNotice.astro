---
import { isDraft, placeholders } from '../data/readiness';

/**
 * Shown in dev and draft builds while values are still TBD. Production builds stop instead.
 * Styled on its own, so the website and the printed CV can both carry it.
 */
const show = isDraft && placeholders.length > 0;
---

{
  show && (
    <aside class="draft" aria-label="Draft notice">
      <div class="draft__inner">
        <p>
          <strong class="draft__flag">Draft</strong>
          <span>
            {placeholders.length} values are still to fill in under <code>src</code>. Production builds stop until
            they are done.
          </span>
        </p>
        <details>
          <summary>Show the list</summary>
          <ul>
            {placeholders.map(({ path, hint }) => (
              <li>
                <code>{path}</code>: {hint}
              </li>
            ))}
          </ul>
        </details>
      </div>
    </aside>
  )
}

<style>
  .draft {
    border-bottom: 1px solid #e3b7be;
    background: #fbe9ec;
    color: #2a1015;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .draft__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 90rem;
    margin-inline: auto;
    padding: 0.5rem clamp(1rem, 3.6vw, 2.5rem);
  }

  .draft p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
  }

  .draft__flag {
    padding: 0.1em 0.5em;
    border: 1.5px solid currentColor;
    color: #a3122a;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .draft code {
    padding: 0.05em 0.3em;
    background: rgb(255 255 255 / 0.7);
    font-size: 0.92em;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    color: #8a0f23;
  }

  details ul {
    margin-top: 0.5rem;
    padding-left: 1.5rem;
    columns: 2 22rem;
  }
</style>
