---
import { isPlaceholder, type Field } from '../lib/placeholder';

/** Renders a data value. Placeholders show their sample, marked TBD with a hint on hover. */
interface Props {
  field: Field;
}

const { field } = Astro.props;
---

{
  isPlaceholder(field) ? (
    <span class="tbd" title={`TBD: ${field.hint}`}>
      {field.sample}
    </span>
  ) : (
    field
  )
}
