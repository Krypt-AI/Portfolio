---
import QRCode from 'qrcode';

/**
 * A scannable QR code for a URL, drawn at build time as SVG. It repeats a link that sits
 * beside it, so assistive tech skips it.
 */
interface Props {
  url: string;
}

const { url } = Astro.props;
const svg = await QRCode.toString(url, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#111418ff', light: '#ffffff00' },
});
---

<span class="qr" aria-hidden="true" set:html={svg} />

<style>
  .qr {
    display: block;
    width: 5.5rem;
    aspect-ratio: 1;
  }

  .qr :global(svg) {
    width: 100%;
    height: 100%;
    shape-rendering: crispEdges;
  }
</style>
