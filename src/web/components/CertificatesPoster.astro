---
import Icon from '../../components/Icon.astro';
import Value from '../../components/Value.astro';
import { certificates } from '../../data/certificates';
import { isPlaceholder, resolve } from '../../lib/placeholder';
import Poster from './Poster.astro';

/** Courses and certificates, newest first, each linking to the issuer's record when there is one. */
---

<Poster id="certificates" pins={[46]}>
  <h2 class="poster-title" id="certificates-title">Certificates</h2>
  {
    certificates.length === 0 ? (
      <p class="certs__empty">None listed yet.</p>
    ) : (
      <ul class="certs">
        {certificates.map((certificate) => (
          <li>
            <strong class="certs__name">
              <Value field={certificate.name} />
            </strong>
            <span class="certs__issuer">
              <Value field={certificate.issuer} />
              {certificate.issued && (
                <>
                  , <Value field={certificate.issued} />
                </>
              )}
            </span>
            {certificate.verifyUrl && (
              <a
                class:list={['link-out', 'certs__verify', { tbd: isPlaceholder(certificate.verifyUrl) }]}
                href={resolve(certificate.verifyUrl)}
                target="_blank"
                rel="noopener"
              >
                Verify<Icon name="external" />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    )
  }
</Poster>

<style>
  .certs {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .certs li {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: 3px solid var(--band);
  }

  .certs__name {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .certs__issuer {
    color: var(--ink-2);
  }

  .certs__verify {
    justify-self: start;
  }

  .certs__empty {
    margin-top: var(--space-4);
    color: var(--ink-2);
  }
</style>
