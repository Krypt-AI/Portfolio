---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

/** A screenshot pinned to a poster, with its caption and where it came from. */
interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  note: string;
  /** The poster column it sits in, for responsive image sizes. */
  sizes: string;
}

const { image, alt, caption, note, sizes } = Astro.props;
---

<figure class="shot-figure">
  <a class="shot-figure__frame" href={image.src} target="_blank" rel="noopener">
    <Picture src={image} formats={['avif', 'webp']} widths={[360, 540, 720, 1080]} sizes={sizes} alt={alt} />
    <span class="visually-hidden">(opens the full-size screenshot in a new tab)</span>
  </a>
  <figcaption class="shot-figure__caption">
    {caption}
    <span class="shot-figure__note">{note}</span>
  </figcaption>
</figure>

<style>
  .shot-figure__frame {
    display: block;
    max-width: 26rem;
    margin-inline: auto;
    border: 1px solid var(--rule);
    box-shadow: 0 1px 2px rgb(17 20 24 / 0.08);
    cursor: zoom-in;
  }

  .shot-figure__frame :global(img) {
    width: 100%;
  }

  .shot-figure__caption {
    max-width: 26rem;
    margin: var(--space-3) auto 0;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .shot-figure__note {
    display: block;
    margin-top: var(--space-1);
    color: var(--ink-3);
  }
</style>
